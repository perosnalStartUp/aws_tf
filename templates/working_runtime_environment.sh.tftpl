#!/bin/bash
set -euo pipefail

install -d -m 0755 /etc/personal-lora
install -m 0644 /dev/null /etc/personal-lora/working-runtime.env
cat > /etc/personal-lora/working-runtime.env <<'RUNTIME_ENV'
${runtime_environment}
RUNTIME_ENV

systemctl enable ${systemd_service_name}
systemctl restart ${systemd_service_name}
